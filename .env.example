# Provider config for every Claude Code invocation in this repo
# (experiments arms + verifier seats). Copy to `.env` and edit.
# Real environment variables override anything set here.
# Full reference: verifier/llm/provider.py

# deepseek (default) | openrouter | custom
GV_PROVIDER=deepseek

# ---- deepseek ---------------------------------------------------------------
# Model id on the DeepSeek API: deepseek-v4-flash | deepseek-v4-pro
#GV_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=sk-...

# ---- openrouter -------------------------------------------------------------
# Model ids are OpenRouter ids, e.g. deepseek/deepseek-v4-flash,
# qwen/qwen3-coder, moonshotai/kimi-k2, anthropic/claude-sonnet-5 ...
# Caveats: OpenRouter's Anthropic-compat endpoint is Bearer-only, so the
# Terminal-Bench claude arms (Harbor forwards the key as x-api-key) are only
# guaranteed on deepseek; tool-use quality varies by model.
#GV_PROVIDER=openrouter
#GV_MODEL=deepseek/deepseek-v4-flash
#OPENROUTER_API_KEY=sk-or-...

# ---- custom (any Anthropic-compatible endpoint) -----------------------------
#GV_PROVIDER=custom
#GV_MODEL=my-model
#GV_ANTHROPIC_BASE_URL=https://my-endpoint.example.com/anthropic
#GV_API_KEY=sk-...
# litellm id for the TurboAgent arm's backend (defaults to GV_MODEL)
#GV_LITELLM_MODEL=openai/my-model

# ---- turbo arm only ---------------------------------------------------------
# TurboAgent's logprob verifier scores with Gemini regardless of provider.
#VERTEX_API_KEY=...

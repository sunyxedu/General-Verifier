# Generic Linux/amd64 Codex runtime; no task data or verifier implementation.
# The base reference is the digest resolved for the local PR #2 pilot build.
FROM --platform=linux/amd64 node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip gcc g++ make pkg-config \
        clang libclang-rt-dev cmake ninja-build llvm lld gdb \
        autoconf automake libtool libtool-bin bison flex texinfo ca-certificates git \
    && npm install --global --ignore-scripts @openai/codex@0.153.4 \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /codex-home /task \
    && chown -R 1000:1000 /codex-home /task

USER 1000:1000
WORKDIR /task
ENTRYPOINT ["codex"]

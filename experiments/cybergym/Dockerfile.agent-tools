# Supply an audited existing Codex agent image reference via --build-arg BASE_IMAGE=...
# Verify that reference's local image ID before building; no model upgrade occurs here.
# Requires a Debian/Ubuntu apt-based base with Python, GCC/Make and user node.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        clang libclang-rt-dev cmake ninja-build llvm lld gdb \
        autoconf automake libtool-bin bison flex texinfo \
    && rm -rf /var/lib/apt/lists/*
USER node
